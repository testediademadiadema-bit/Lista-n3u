    let currentChannels = [];
    let activeIndex = -1;
    let activeHls = null;

    // GERADOR DE ID PARA CHANNELID
    function generateChannelId(name) {
      return name.toLowerCase().replace(/[^a-z0-9]/g, '');
    }

    function parseM3UText(text) {
      const lines = text.split('\n');
      const channels = [];
      let currentName = '';

      lines.forEach(line => {
        const l = line.trim();
        if (l.startsWith('#EXTINF:')) {
          const commaIndex = l.indexOf(',');
          currentName = commaIndex !== -1 ? l.slice(commaIndex + 1).trim() : 'Canal sem nome';
        } else if (l.startsWith('http://') || l.startsWith('https://')) {
          channels.push({ name: currentName || 'Canal sem nome', url: l });
          currentName = '';
        } else if (l.includes(',')) {
          const parts = l.split(',');
          if (parts.length >= 2 && parts[1].startsWith('http')) {
            channels.push({ name: parts[0].trim(), url: parts[1].trim() });
          }
        }
      });
      return channels;
    }

    function init() {
      const saved = localStorage.getItem('mobile_media_channels');
      if (saved) {
        currentChannels = JSON.parse(saved);
      } else {
        currentChannels = parseM3UText(m3uRawData);
      }
      renderChannels(currentChannels);
      updateClock();
      setInterval(updateClock, 1000);
    }

    function renderChannels(list) {
      const container = document.getElementById('channels-list');
      container.innerHTML = '';

      list.forEach((ch, index) => {
        const item = document.createElement('div');
        item.className = `channel-item ${index === activeIndex ? 'active' : ''}`;
        item.onclick = () => playChannel(index);

        const urlLower = ch.url.toLowerCase();
        const isAudio = urlLower.includes('.mp3') || urlLower.includes('.aac') || urlLower.includes('.ogg') || urlLower.includes('stream') || urlLower.includes('radio');
        
        item.innerHTML = `
          <div class="channel-info-left">
            <div>${isAudio ? '📻' : '📺'}</div>
            <div class="channel-name">${ch.name}</div>
          </div>
          <div class="channel-type">${isAudio ? 'ÁUDIO' : 'VÍDEO'}</div>
        `;
        container.appendChild(item);
      });

      document.getElementById('count-badge').textContent = list.length;
    }

    function destroyHLS() {
      if (activeHls) {
        activeHls.destroy();
        activeHls = null;
      }
    }

    function playChannel(index) {
      if (index < 0 || index >= currentChannels.length) return;
      activeIndex = index;
      destroyHLS();

      const channel = currentChannels[activeIndex];
      const screen = document.getElementById('player-screen');
      const urlLower = channel.url.toLowerCase();

      document.getElementById('top-channel-title').textContent = channel.name;

      const isAudioDirect = urlLower.endsWith('.aac') || urlLower.endsWith('.mp3') || urlLower.endsWith('.ogg') || urlLower.includes('/audio') || urlLower.includes('radio');
      const isHLS = urlLower.includes('.m3u8') || urlLower.includes('.m3u');

      if (isAudioDirect) {
        screen.innerHTML = `
          <div class="audio-player-ui">
            <div class="audio-icon-box">📻</div>
            <div class="audio-waves active" id="eink-waves">
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
            </div>
            <audio id="audio-el" controls autoplay style="margin-top: 5px;">
              <source src="${channel.url}">
            </audio>
          </div>
        `;
        const aEl = document.getElementById('audio-el');
        const wavesEl = document.getElementById('eink-waves');
        aEl.onplay = () => wavesEl.classList.add('active');
        aEl.onpause = () => wavesEl.classList.remove('active');
        aEl.play().catch(() => {});
      } else if (isHLS) {
        screen.innerHTML = `<video id="video-el" controls autoplay playsinline></video>`;
        const vEl = document.getElementById('video-el');

        if (Hls.isSupported()) {
          activeHls = new Hls();
          activeHls.loadSource(channel.url);
          activeHls.attachMedia(vEl);
          activeHls.on(Hls.Events.MANIFEST_PARSED, () => vEl.play().catch(() => {}));
        } else if (vEl.canPlayType('application/vnd.apple.mpegurl')) {
          vEl.src = channel.url;
          vEl.play().catch(() => {});
        } else {
          screen.innerHTML = `<iframe src="${channel.url}" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
        }
      } else {
        screen.innerHTML = `<iframe src="${channel.url}" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
      }

      renderChannels(currentChannels);
    }

    function addChannel() {
      const nameInput = document.getElementById('add-name');
      const urlInput = document.getElementById('add-url');

      const name = nameInput.value.trim();
      const url = urlInput.value.trim();

      if (!name || !url) {
        alert("Preencha o Nome e a URL do canal.");
        return;
      }

      currentChannels.push({ name, url });
      localStorage.setItem('mobile_media_channels', JSON.stringify(currentChannels));

      nameInput.value = '';
      urlInput.value = '';

      renderChannels(currentChannels);
    }

    document.getElementById('btn-upload').onclick = () => {
      document.getElementById('file-upload').click();
    };

    document.getElementById('file-upload').onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        const text = evt.target.result;
        const importedChannels = parseM3UText(text);

        if (importedChannels.length > 0) {
          currentChannels = [...currentChannels, ...importedChannels];
          localStorage.setItem('mobile_media_channels', JSON.stringify(currentChannels));
          renderChannels(currentChannels);
          alert(`${importedChannels.length} canais importados!`);
        } else {
          alert("Nenhum canal válido foi encontrado.");
        }
      };
      reader.readAsText(file);
    };

    document.getElementById('btn-download').onclick = () => {
      document.getElementById('download-modal').classList.add('active');
    };

    document.getElementById('dl-close').onclick = () => {
      document.getElementById('download-modal').classList.remove('active');
    };

    // DOWNLOAD NO FORMATO EXATO PEDIDO: #EXTM3U e #EXTINF:0 type="stream" channelId="..."
    document.getElementById('dl-m3u').onclick = () => {
      let content = "#EXTM3U\n";
      currentChannels.forEach(ch => {
        const chId = generateChannelId(ch.name);
        content += `#EXTINF:0 type="stream" channelId="${chId}",${ch.name}\n${ch.url}\n`;
      });
      downloadFile(content, "lista_canais.m3u", "text/plain");
      document.getElementById('download-modal').classList.remove('active');
    };

    document.getElementById('dl-txt').onclick = () => {
      let content = "#EXTM3U\n";
      currentChannels.forEach(ch => {
        const chId = generateChannelId(ch.name);
        content += `#EXTINF:0 type="stream" channelId="${chId}",${ch.name}\n${ch.url}\n`;
      });
      downloadFile(content, "lista_canais.txt", "text/plain");
      document.getElementById('download-modal').classList.remove('active');
    };

    function downloadFile(content, fileName, contentType) {
      const a = document.createElement("a");
      const file = new Blob([content], { type: contentType });
      a.href = URL.createObjectURL(file);
      a.download = fileName;
      a.click();
    }

    function openMaximize() {
      if (activeIndex < 0) {
        alert("Selecione um canal antes de maximizar.");
        return;
      }

      const channel = currentChannels[activeIndex];
      document.getElementById('max-title').textContent = channel.name;

      const urlLower = channel.url.toLowerCase();
      const isAudioDirect = urlLower.endsWith('.aac') || urlLower.endsWith('.mp3') || urlLower.endsWith('.ogg') || urlLower.includes('/audio') || urlLower.includes('radio');
      const isHLS = urlLower.includes('.m3u8') || urlLower.includes('.m3u');

      const maxBody = document.getElementById('max-body');

      if (isAudioDirect) {
        maxBody.innerHTML = `
          <div class="audio-player-ui" style="background: #ffffff;">
            <div class="audio-icon-box" style="font-size:3rem;">📻</div>
            <div class="audio-waves active" id="max-waves">
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
              <div class="audio-bar"></div>
            </div>
            <audio id="max-audio-el" controls autoplay style="width: 80%; max-width: 400px; margin-top: 20px;">
              <source src="${channel.url}">
            </audio>
          </div>
        `;
        const mA = document.getElementById('max-audio-el');
        const mWaves = document.getElementById('max-waves');
        mA.onplay = () => mWaves.classList.add('active');
        mA.onpause = () => mWaves.classList.remove('active');
        mA.play().catch(() => {});
      } else if (isHLS) {
        maxBody.innerHTML = `<video id="max-video-el" controls autoplay playsinline style="width:100%; height:100%;"></video>`;
        const maxVideo = document.getElementById('max-video-el');
        if (Hls.isSupported()) {
          const maxHls = new Hls();
          maxHls.loadSource(channel.url);
          maxHls.attachMedia(maxVideo);
          maxHls.on(Hls.Events.MANIFEST_PARSED, () => maxVideo.play().catch(() => {}));
        } else if (maxVideo.canPlayType('application/vnd.apple.mpegurl')) {
          maxVideo.src = channel.url;
          maxVideo.play().catch(() => {});
        }
      } else {
        maxBody.innerHTML = `<iframe src="${channel.url}" allow="autoplay; fullscreen" allowfullscreen style="width:100%; height:100%; border:none;"></iframe>`;
      }

      document.getElementById('max-modal').classList.add('active');
    }

    function closeMaximize() {
      document.getElementById('max-modal').classList.remove('active');
      document.getElementById('max-body').innerHTML = '';
    }

    document.getElementById('btn-add').onclick = addChannel;
    document.getElementById('btn-maximize').onclick = openMaximize;
    document.getElementById('btn-close-max').onclick = closeMaximize;

    document.getElementById('btn-clear-all').onclick = () => {
      if (confirm("Deseja apagar os canais salvos?")) {
        currentChannels = [];
        localStorage.removeItem('mobile_media_channels');
        destroyHLS();
        renderChannels(currentChannels);
      }
    };

    document.getElementById('search-input').oninput = (e) => {
      const term = e.target.value.toLowerCase();
      const filtered = currentChannels.filter(c => c.name.toLowerCase().includes(term));
      renderChannels(filtered);
    };

    document.getElementById('btn-next').onclick = () => {
      if (currentChannels.length > 0) playChannel((activeIndex + 1) % currentChannels.length);
    };

    document.getElementById('btn-prev').onclick = () => {
      if (currentChannels.length > 0) playChannel((activeIndex - 1 + currentChannels.length) % currentChannels.length);
    };

    function updateClock() {
      const now = new Date();
      document.getElementById('clock').textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    init();
  </script>
</body>
</html>
