<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>E-Ink TV & Rádio</title>
  <!-- Biblioteca para interpretar streams HLS (.m3u / .m3u8) -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Courier New", Courier, monospace, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    /* ESTILO TELA E-INK (P&B, Alto Contraste, Retrô/Paper) */
    body {
      background-color: #f2f2ef;
      color: #111111;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 10px;
      gap: 10px;
      width: 100%;
      overflow-x: hidden;
    }

    .card {
      background: #ffffff;
      border: 2px solid #111111;
      border-radius: 4px;
      padding: 10px;
      box-shadow: 2px 2px 0px #111111;
      width: 100%;
    }

    /* TOPO E-INK COM NOME DO CANAL CENTRALIZADO */
    .top-header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid #111111;
    }

    .weather-info {
      font-size: 0.75rem;
      font-weight: bold;
      white-space: nowrap;
    }

    .current-channel-title {
      text-align: center;
      font-size: 0.85rem;
      font-weight: bold;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      padding: 0 4px;
    }

    .time-info .clock {
      font-size: 0.9rem;
      font-weight: bold;
    }

    /* PLAYER DE MÍDIA */
    .player-screen {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #e8e8e5;
      border: 2px solid #111111;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .player-screen iframe, .player-screen video {
      width: 100%;
      height: 100%;
      border: none;
      object-fit: contain;
    }

    /* PLAYER DE ÁUDIO NO ESTILO E-INK */
    .audio-player-ui {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      height: 100%;
      background: #fbfbf9;
      padding: 10px;
    }

    .audio-icon-box {
      font-size: 2rem;
      border: 2px solid #111111;
      padding: 8px 16px;
      background: #ffffff;
      box-shadow: 2px 2px 0px #111111;
    }

    .audio-waves {
      display: flex;
      align-items: center;
      gap: 4px;
      height: 16px;
    }

    .audio-bar {
      width: 4px;
      background-color: #111111;
      height: 20%;
    }

    .audio-waves.active .audio-bar {
      animation: eink-bounce 1s infinite alternate ease-in-out;
    }

    .audio-waves.active .audio-bar:nth-child(1) { animation-delay: 0.1s; }
    .audio-waves.active .audio-bar:nth-child(2) { animation-delay: 0.4s; }
    .audio-waves.active .audio-bar:nth-child(3) { animation-delay: 0.2s; }
    .audio-waves.active .audio-bar:nth-child(4) { animation-delay: 0.5s; }
    .audio-waves.active .audio-bar:nth-child(5) { animation-delay: 0.3s; }

    @keyframes eink-bounce {
      0% { height: 20%; }
      100% { height: 100%; }
    }

    .audio-player-ui audio {
      width: 90%;
      height: 36px;
      filter: grayscale(100%);
    }

    .placeholder-text {
      color: #333333;
      font-size: 0.85rem;
      text-align: center;
      font-weight: bold;
    }

    /* CONTROLES E-INK */
    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 8px;
    }

    .ctrl-btn {
      background: #ffffff;
      border: 2px solid #111111;
      width: 40px;
      height: 40px;
      color: #111111;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      font-size: 1.1rem;
      font-weight: bold;
      box-shadow: 2px 2px 0px #111111;
    }

    .ctrl-btn:active {
      background: #111111;
      color: #ffffff;
      box-shadow: 0px 0px 0px #111111;
      transform: translate(2px, 2px);
    }

    /* FORMULÁRIO */
    .add-form {
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: #fbfbf9;
      padding: 8px;
      border: 1px solid #111111;
      margin: 8px 0;
    }

    .add-form input {
      width: 100%;
      background: #ffffff;
      border: 1px solid #111111;
      padding: 8px;
      color: #111111;
      font-size: 0.8rem;
      outline: none;
    }

    .btn-submit {
      background: #ffffff;
      color: #111111;
      border: 2px solid #111111;
      padding: 8px;
      font-size: 0.85rem;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 2px 2px 0px #111111;
    }

    .btn-submit:active {
      background: #111111;
      color: #ffffff;
      box-shadow: 0px 0px 0px #111111;
      transform: translate(2px, 2px);
    }

    /* LISTA CONTINUA DE CANAIS */
    .library-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .badge-count {
      background: #111111;
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 1px 6px;
    }

    .btn-clear {
      background: none;
      border: none;
      color: #111111;
      text-decoration: underline;
      font-size: 0.75rem;
      cursor: pointer;
      font-weight: bold;
    }

    .search-box input {
      width: 100%;
      background: #ffffff;
      border: 1px solid #111111;
      padding: 8px;
      color: #111111;
      font-size: 0.8rem;
      outline: none;
      margin-bottom: 8px;
    }

    /* LISTA VERTICAL */
    .channels-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      max-height: 280px;
      overflow-y: auto;
    }

    .channel-item {
      background: #ffffff;
      border: 1px solid #111111;
      padding: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .channel-item.active {
      background: #111111;
      color: #ffffff;
    }

    .channel-item.active .channel-type {
      color: #dddddd;
    }

    .channel-info-left {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow: hidden;
    }

    .channel-name {
      font-size: 0.85rem;
      font-weight: bold;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .channel-type {
      font-size: 0.7rem;
      color: #666666;
      white-space: nowrap;
    }

    /* MODAL TELA CHEIA */
    .fullscreen-modal {
      position: fixed;
      inset: 0;
      background: #f2f2ef;
      z-index: 99999;
      display: none;
      flex-direction: column;
    }

    .fullscreen-modal.active {
      display: flex;
    }

    .fullscreen-header {
      padding: 8px 12px;
      background: #ffffff;
      border-bottom: 2px solid #111111;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .fullscreen-title {
      color: #111111;
      font-size: 0.9rem;
      font-weight: bold;
    }

    .btn-close-max {
      background: #ffffff;
      color: #111111;
      border: 2px solid #111111;
      padding: 4px 12px;
      font-size: 0.8rem;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 2px 2px 0px #111111;
    }

    .fullscreen-body {
      flex: 1;
      width: 100vw;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #000;
    }

    /* MODAL DE DOWNLOAD */
    .download-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .download-modal.active {
      display: flex;
    }

    .download-box {
      background: #ffffff;
      border: 2px solid #111111;
      padding: 16px;
      width: 100%;
      max-width: 300px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: 4px 4px 0px #111111;
    }

    .download-btn {
      background: #ffffff;
      border: 1px solid #111111;
      color: #111111;
      padding: 8px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: bold;
      text-align: center;
    }

    .download-btn:active {
      background: #111111;
      color: #ffffff;
    }
  </style>
</head>
<body>

